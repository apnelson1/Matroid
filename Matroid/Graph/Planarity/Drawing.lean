/-!
# Drawings of graphs

This file defines a drawing of a graph in an arbitrary topological space to be a continuous
injection from the weak realization of the graph. It also records the construction and transport
statements needed for the topological formulation of Kuratowski's theorem.

The plane-specific part of the API is deliberately small. The difficult local topology used to
split a contracted vertex is hidden behind
`Graph.Drawing.planar_of_contract_of_facial_cycle_two_paths`.

## Main definitions

- `Graph.Drawing`: a continuous injection from the weak realization of a graph.
- `Graph.IsDrawable`: existence of a drawing in a specified topological space.
- `Graph.Planar`: existence of a drawing in the Euclidean plane.
- `Graph.Drawing.Face`: a connected component of the complement of a drawing.
- `Graph.Drawing.IsFacialSubgraph`: a subgraph whose drawing is the frontier of a face.

## Main statements

- `Graph.Drawing.ofVertexAndEdgePaths`: construct a drawing from pairwise internally disjoint edge
  paths.
- `Graph.Drawing.restrict`: restrict a drawing to a subgraph.
- `Graph.Drawing.exists_facial_cycle_of_delete_vertex`: deleting a vertex of a 3-connected plane
  drawing exposes its neighbors on a facial cycle.
- `Graph.Drawing.planar_of_contract_of_facial_cycle_two_paths`: split a contracted vertex when
  the two sets of neighbors occur on two sides of a facial cycle.
- `Graph.Planar.isTopologicalMinor`: planarity is inherited by topological minors.

## Implementation notes

`Graph.Drawing` contains only continuity and injectivity. Compactness, separation, simplicity, and
finiteness are not part of the definition.

## Tags

graph drawing, graph embedding, planar graph, Kuratowski theorem
-/

open Function Set Topology
open scoped unitInterval Convex

namespace Graph

noncomputable section

universe u v w

variable {α β γ δ : Type*} {G H : Graph α β} {K : Graph γ δ} {e : β} {u v : α}
variable {X : Type u} {Y : Type v} [TopologicalSpace X] [TopologicalSpace Y]

/-- A drawing of `G` in `X` is a continuous injection from the weak realization of `G` to `X`. -/
structure Drawing (G : Graph α β) (X : Type u) [TopologicalSpace X] extends
    C(Realization G, X), Realization G ↪ X

-- This parent projection is generated by the `extends` command.
attribute [nolint docBlame] Drawing.toEmbedding

namespace Drawing

variable {D D' : Drawing G X}

instance : FunLike (Drawing G X) (Realization G) X where
  coe D := D.toContinuousMap
  coe_injective D₁ D₂ h := by
    cases D₁
    cases D₂
    simpa using h

instance : ContinuousMapClass (Drawing G X) (Realization G) X where
  map_continuous D := D.toContinuousMap.continuous

instance : EmbeddingLike (Drawing G X) (Realization G) X where
  injective' D := D.toEmbedding.injective

@[ext]
theorem ext {D₁ D₂ : Drawing G X} (h : ∀ x, D₁ x = D₂ x) : D₁ = D₂ :=
  DFunLike.coe_injective <| funext h

@[simp]
lemma coe_toContinuousMap (D : Drawing G X) : ⇑D.toContinuousMap = D := rfl

/-- A drawing is continuous. -/
lemma continuous (D : Drawing G X) : Continuous D :=
  D.toContinuousMap.continuous

/-- A drawing is injective. -/
lemma injective (D : Drawing G X) : Injective D :=
  D.toEmbedding.injective

/-- The point assigned by a drawing to a vertex. -/
def vertex (D : Drawing G X) (x : V(G)) : X :=
  D (vertexMk x)

/-- The path assigned by a drawing to an edge. -/
noncomputable def edgePath (D : Drawing G X) (e : E(G)) :
    Path (D.vertex (edgeSource e)) (D.vertex (edgeTarget e)) :=
  (G.edgePath e).map D.continuous

/-- The open image of a path, with both endpoints omitted. -/
def pathInterior {x y : X} (P : Path x y) : Set X :=
  P '' Ioo (0 : unitInterval) 1

/-- The image of the realization under a drawing. -/
def support (D : Drawing G X) : Set X :=
  range D

@[simp]
lemma vertex_mem_support (D : Drawing G X) (x : V(G)) : D.vertex x ∈ D.support :=
  ⟨vertexMk x, rfl⟩

lemma edgePath_range_subset_support (D : Drawing G X) (e : E(G)) :
    range (D.edgePath e) ⊆ D.support := by
  rintro _ ⟨t, rfl⟩
  refine ⟨G.edgePath e t, rfl⟩

/-- Distinct vertices have distinct images in a drawing. -/
lemma vertex_injective (D : Drawing G X) : Injective D.vertex :=
  fun _ _ hxy ↦ vertexMk_inj.mp <| D.injective hxy

@[simp]
lemma edgePath_apply (D : Drawing G X) (e : E(G)) (t : I) : D.edgePath e t = D (G.edgePath e t) :=
  rfl

/-- Every point of the support is either a vertex image or lies on some edge path. -/
lemma support_eq (D : Drawing G X) :
    D.support = range D.vertex ∪ ⋃ e : E(G), range (D.edgePath e) := by
  ext x
  simp only [support, mem_range, mem_union, mem_iUnion]
  constructor
  · rintro ⟨y, rfl⟩
    induction y using Realization.ind with | h a =>
    match a with
    | .inl v => exact Or.inl ⟨v, rfl⟩
    | .inr ⟨e, t⟩ => exact Or.inr ⟨e, t, by simp [edgePath_apply]⟩
  · rintro (⟨v, rfl⟩ | ⟨e, t, rfl⟩)
    · exact ⟨vertexMk v, rfl⟩
    · exact ⟨G.edgePath e t, rfl⟩

/-- The open part of each edge path is injectively parametrized. -/
lemma edgePath_injOn_Ioo (D : Drawing G X) (e : E(G)) :
    InjOn (D.edgePath e) (Ioo (0 : unitInterval) 1) :=
  fun _ ht₁ _ _ heq ↦ edgePath_inj_of_mem_Ioo (mod_cast ht₁) <| D.injective heq

/-- The open part of an edge is disjoint from all vertex images. -/
lemma pathInterior_edgePath_disjoint_vertex (D : Drawing G X) (e : E(G)) :
    Disjoint (pathInterior (D.edgePath e)) (range D.vertex) := by
  refine disjoint_left.mpr ?_
  rintro _ ⟨t, ht, rfl⟩ ⟨v, hv⟩
  exact vertexMk_not_mem_edgePath_Ioo v e ⟨t, ht, D.injective hv.symm⟩

/-- The open parts of distinct edges are disjoint. -/
lemma pathInterior_edgePath_disjoint (D : Drawing G X) {e f : E(G)} (hef : e ≠ f) :
    Disjoint (pathInterior (D.edgePath e)) (pathInterior (D.edgePath f)) := by
  refine disjoint_left.mpr ?_
  rintro _ ⟨t, ht, rfl⟩ ⟨s, hs, heq⟩
  exact ((disjoint_edgePath_Ioo_iff e f).mpr hef).notMem_of_mem_left ⟨t, ht, rfl⟩
    ⟨s, hs, D.injective heq⟩

/-- The support of a drawing of a finite graph is compact. -/
lemma support_isCompact [G.Finite] (D : Drawing G X) : IsCompact D.support :=
  isCompact_range D.continuous

/-- In a Hausdorff space, the support of a drawing of a finite graph is closed. -/
lemma support_isClosed [G.Finite] [T2Space X] (D : Drawing G X) : IsClosed D.support :=
  D.support_isCompact.isClosed

/-- Postcompose a drawing with a continuous injection of ambient spaces. -/
def postcomp (D : Drawing G X) (f : C(X, Y)) (hf : Injective f) : Drawing G Y where
  toContinuousMap := f.comp D.toContinuousMap
  inj' := hf.comp D.injective

@[simp]
lemma postcomp_apply (D : Drawing G X) (f : C(X, Y)) (hf : Injective f)
    (x : Realization G) : D.postcomp f hf x = f (D x) :=
  rfl

/-! ### Constructors -/

/-- Construct a drawing from a map on the pre-realization that identifies exactly the points
identified by the realization quotient. -/
noncomputable def ofPreRealization (f : C(G.PreRealization, X))
    (map_eq_of_glueRel : ∀ a b, G.glueRel a b → f a = f b)
    (glueRel_of_map_eq : ∀ a b, f a = f b → G.glueRel a b) : Drawing G X where
  toContinuousMap :=
    ⟨Quotient.lift f map_eq_of_glueRel, continuous_quot_lift map_eq_of_glueRel f.continuous⟩
  inj' x y h := by
    induction x using Realization.ind with | h a =>
    induction y using Realization.ind with | h b =>
    exact Realization.mk_eq_mk.mpr (glueRel_of_map_eq a b h)

/-- Construct a drawing by assigning distinct points to vertices and internally disjoint paths to
edges.

The hypotheses allow loops and parallel edges. For a loop, the two endpoints of its path agree,
as prescribed by `edgeSource` and `edgeTarget`; only the open interval is required to be
injective. -/
noncomputable def preRealizationMapOfPaths (vertex : V(G) → X)
    (edge : ∀ e : E(G), Path (vertex (edgeSource e)) (vertex (edgeTarget e))) :
    C(G.PreRealization, X) :=
  ⟨Sum.elim vertex fun p ↦ edge p.1 p.2,
    continuous_sum_dom.mpr ⟨continuous_of_discreteTopology,
      continuous_sigma fun e ↦ (edge e).continuous⟩⟩

@[simp]
lemma preRealizationMapOfPaths_inl (vertex : V(G) → X)
    (edge : ∀ e : E(G), Path (vertex (edgeSource e)) (vertex (edgeTarget e))) (x : V(G)) :
    preRealizationMapOfPaths vertex edge (Sum.inl x) = vertex x := rfl

@[simp]
lemma preRealizationMapOfPaths_inr (vertex : V(G) → X)
    (edge : ∀ e : E(G), Path (vertex (edgeSource e)) (vertex (edgeTarget e)))
    (e : E(G)) (t : unitInterval) :
    preRealizationMapOfPaths vertex edge (Sum.inr ⟨e, t⟩) = edge e t := rfl

/-- The endpoints of the paths are where the realization glues, so the map respects the relation.
This direction needs no hypothesis: it is `Path.source` and `Path.target`. -/
theorem map_eq_of_glueRel_preRealizationMapOfPaths (vertex : V(G) → X)
    (edge : ∀ e : E(G), Path (vertex (edgeSource e)) (vertex (edgeTarget e))) :
    ∀ a b, G.glueRel a b →
      preRealizationMapOfPaths vertex edge a = preRealizationMapOfPaths vertex edge b := by
  intro a b h
  induction h with
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ h₁ h₂ => exact h₁.trans h₂
  | rel x y hxy =>
    match x, y with
    | .inr _, _ =>
      simp [glueRelAux] at hxy
    | .inl u, .inl v =>
      obtain rfl := (glueRelAux_inl_inl_iff ..).mp hxy
      rfl
    | .inl u, .inr ⟨e, t⟩ =>
      obtain ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ := (glueRelAux_inl_inr_iff ..).mp hxy
      · simp [Path.source]
      · simp [Path.target]

/-- Conversely, the map identifies *only* what the realization glues. This is where all four
hypotheses are used, and it is the whole mathematical content of `ofVertexAndEdgePaths`. -/
theorem glueRel_of_map_eq_preRealizationMapOfPaths (vertex : V(G) → X)
    (vertex_injective : Injective vertex)
    (edge : ∀ e : E(G), Path (vertex (edgeSource e)) (vertex (edgeTarget e)))
    (edge_injective : ∀ e, InjOn (edge e) (Ioo (0 : unitInterval) 1))
    (edge_interior_disjoint_vertex : ∀ e, Disjoint (pathInterior (edge e)) (range vertex))
    (edge_interior_disjoint : ∀ e f, e ≠ f →
      Disjoint (pathInterior (edge e)) (pathInterior (edge f))) :
    ∀ a b, preRealizationMapOfPaths vertex edge a = preRealizationMapOfPaths vertex edge b →
      G.glueRel a b := by
  intro a b h
  match a, b with
  | .inl u, .inl v =>
    exact (glueRel_inl_inl_iff u v).mpr (vertex_injective (by simpa using h))
  | .inl u, .inr ⟨e, t⟩ =>
    have hvt : vertex u = edge e t := by simpa using h
    rcases eq_or_ne t 0 with rfl | ht0
    · exact (glueRel_inl_inr_iff u e 0).mpr <|
        .inl ⟨rfl, vertex_injective (by simpa [Path.source] using hvt)⟩
    rcases eq_or_ne t 1 with rfl | ht1
    · exact (glueRel_inl_inr_iff u e 1).mpr <|
        .inr ⟨rfl, vertex_injective (by simpa [Path.target] using hvt)⟩
    · exact ((edge_interior_disjoint_vertex e).notMem_of_mem_left
        ⟨t, ⟨unitInterval.pos_iff_ne_zero.mpr ht0, unitInterval.lt_one_iff_ne_one.mpr ht1⟩, rfl⟩
        ⟨u, hvt⟩).elim
  | .inr ⟨e, t⟩, .inl v =>
    have hvt : edge e t = vertex v := by simpa using h
    rcases eq_or_ne t 0 with rfl | ht0
    · exact (glueRel_inr_inl_iff e 0 v).mpr <|
        .inl ⟨rfl, vertex_injective (by simpa [Path.source] using hvt.symm)⟩
    rcases eq_or_ne t 1 with rfl | ht1
    · exact (glueRel_inr_inl_iff e 1 v).mpr <|
        .inr ⟨rfl, vertex_injective (by simpa [Path.target] using hvt.symm)⟩
    · exact ((edge_interior_disjoint_vertex e).notMem_of_mem_left
        ⟨t, ⟨unitInterval.pos_iff_ne_zero.mpr ht0, unitInterval.lt_one_iff_ne_one.mpr ht1⟩, rfl⟩
        ⟨v, hvt.symm⟩).elim
  | .inr ⟨e₁, t₁⟩, .inr ⟨e₂, t₂⟩ =>
    have heq : edge e₁ t₁ = edge e₂ t₂ := by simpa using h
    rcases eq_or_ne t₁ 0 with rfl | ht₁₀
    · rcases eq_or_ne t₂ 0 with rfl | ht₂₀
      · have hv : edgeSource e₁ = edgeSource e₂ :=
          vertex_injective (by simpa [Path.source] using heq)
        refine (glueRel_inr_inr_iff e₁ e₂ 0 0).mpr <| Or.inr ⟨edgeSource e₁, by simp, ?_⟩
        simp [hv]
      rcases eq_or_ne t₂ 1 with rfl | ht₂₁
      · have hv : edgeSource e₁ = edgeTarget e₂ :=
          vertex_injective (by simpa [Path.source, Path.target] using heq)
        refine (glueRel_inr_inr_iff e₁ e₂ 0 1).mpr <| Or.inr ⟨edgeSource e₁, by simp, ?_⟩
        simp [hv]
      · exact ((edge_interior_disjoint_vertex e₂).notMem_of_mem_left
          ⟨t₂, ⟨unitInterval.pos_iff_ne_zero.mpr ht₂₀, unitInterval.lt_one_iff_ne_one.mpr ht₂₁⟩, rfl⟩
          ⟨edgeSource e₁, by simpa [Path.source] using heq⟩).elim
    rcases eq_or_ne t₁ 1 with rfl | ht₁₁
    · rcases eq_or_ne t₂ 0 with rfl | ht₂₀
      · have hv : edgeTarget e₁ = edgeSource e₂ :=
          vertex_injective (by simpa [Path.source, Path.target] using heq)
        refine (glueRel_inr_inr_iff e₁ e₂ 1 0).mpr <| Or.inr ⟨edgeTarget e₁, by simp, ?_⟩
        simp [hv]
      rcases eq_or_ne t₂ 1 with rfl | ht₂₁
      · have hv : edgeTarget e₁ = edgeTarget e₂ :=
          vertex_injective (by simpa [Path.target] using heq)
        refine (glueRel_inr_inr_iff e₁ e₂ 1 1).mpr <| Or.inr ⟨edgeTarget e₁, by simp, ?_⟩
        simp [hv]
      · exact ((edge_interior_disjoint_vertex e₂).notMem_of_mem_left
          ⟨t₂, ⟨unitInterval.pos_iff_ne_zero.mpr ht₂₀, unitInterval.lt_one_iff_ne_one.mpr ht₂₁⟩, rfl⟩
          ⟨edgeTarget e₁, by simpa [Path.target] using heq⟩).elim
    · have ht₁ : t₁ ∈ Ioo (0 : I) 1 :=
        ⟨unitInterval.pos_iff_ne_zero.mpr ht₁₀, unitInterval.lt_one_iff_ne_one.mpr ht₁₁⟩
      rcases eq_or_ne t₂ 0 with rfl | ht₂₀
      · exact ((edge_interior_disjoint_vertex e₁).notMem_of_mem_left ⟨t₁, ht₁, rfl⟩
          ⟨edgeSource e₂, by simpa [Path.source] using heq.symm⟩).elim
      rcases eq_or_ne t₂ 1 with rfl | ht₂₁
      · exact ((edge_interior_disjoint_vertex e₁).notMem_of_mem_left ⟨t₁, ht₁, rfl⟩
          ⟨edgeTarget e₂, by simpa [Path.target] using heq.symm⟩).elim
      · have ht₂ : t₂ ∈ Ioo (0 : I) 1 :=
          ⟨unitInterval.pos_iff_ne_zero.mpr ht₂₀, unitInterval.lt_one_iff_ne_one.mpr ht₂₁⟩
        obtain rfl | he := eq_or_ne e₁ e₂
        · exact (glueRel_inr_inr_iff e₁ e₁ t₁ t₂).mpr <|
            Or.inl ⟨rfl, edge_injective e₁ ht₁ ht₂ heq⟩
        · exact ((edge_interior_disjoint e₁ e₂ he).notMem_of_mem_left
            ⟨t₁, ht₁, rfl⟩ ⟨t₂, ht₂, heq.symm⟩).elim

noncomputable def ofVertexAndEdgePaths
    (vertex : V(G) → X) (vertex_injective : Injective vertex)
    (edge : ∀ e : E(G), Path (vertex (edgeSource e)) (vertex (edgeTarget e)))
    (edge_injective : ∀ e, InjOn (edge e) (Ioo (0 : unitInterval) 1))
    (edge_interior_disjoint_vertex : ∀ e, Disjoint (pathInterior (edge e)) (range vertex))
    (edge_interior_disjoint : ∀ e f, e ≠ f →
      Disjoint (pathInterior (edge e)) (pathInterior (edge f))) :
    Drawing G X :=
  ofPreRealization (preRealizationMapOfPaths vertex edge)
    (map_eq_of_glueRel_preRealizationMapOfPaths vertex edge)
    (glueRel_of_map_eq_preRealizationMapOfPaths vertex vertex_injective edge edge_injective
      edge_interior_disjoint_vertex edge_interior_disjoint)

variable {vertex : V(G) → X} {edge : ∀ e : E(G), Path (vertex (edgeSource e))
  (vertex (edgeTarget e))} {hv : Injective vertex} {he : ∀ e, InjOn (edge e) (Ioo (0 : I) 1)}
  {hev : ∀ e, Disjoint (pathInterior (edge e)) (range vertex)}
  {hee : ∀ e f, e ≠ f → Disjoint (pathInterior (edge e)) (pathInterior (edge f))}

@[simp]
lemma ofVertexAndEdgePaths_vertex (x : V(G)) :
    (ofVertexAndEdgePaths vertex hv edge he hev hee).vertex x = vertex x := rfl

@[simp]
lemma ofVertexAndEdgePaths_edgePath_apply (e : E(G)) (t : unitInterval) :
    (ofVertexAndEdgePaths vertex hv edge he hev hee).edgePath e t = edge e t := rfl

lemma range_edgePath_ofVertexAndEdgePaths (e : E(G)) :
    range ((ofVertexAndEdgePaths vertex hv edge he hev hee).edgePath e) = range (edge e) := rfl

/-- The empty graph has a drawing in every topological space, including the empty space. -/
noncomputable def bot (X : Type u) [TopologicalSpace X] : Drawing (⊥ : Graph α β) X :=
  ofPreRealization ⟨fun a ↦ isEmptyElim a, continuous_of_discreteTopology⟩
    (fun a ↦ isEmptyElim a) (fun a ↦ isEmptyElim a)

/-! ### Restriction and transport -/

/-- Restrict a drawing to a subgraph. -/
def restrict (D : Drawing G X) (h : H ≤ G) : Drawing H X where
  toContinuousMap := D.toContinuousMap.comp h.realizationContinuousMap
  inj' := D.injective.comp h.RealizationEmbedding_isEmbedding.injective

@[simp]
lemma restrict_apply (D : Drawing G X) (h : H ≤ G) (x : Realization H) :
    D.restrict h x = D (h.RealizationEmbedding x) := rfl

/-! Restriction changes neither the position of a vertex nor the image of an edge. The two
`edgeSource`/`edgeTarget` statements are the ones that would fail if the orientation of an edge
were chosen per graph rather than determined by its ends; they hold because `ArbRel` fixes one
linear order per *type*, so `IsSubgraph.source` and `IsSubgraph.target` are available. -/

@[simp]
lemma restrict_vertex (D : Drawing G X) (h : H ≤ G) (x : V(H)) :
    (D.restrict h).vertex x = D.vertex ⟨x.1, vertexSet_mono h x.2⟩ := by
  simp [vertex, restrict_apply]

lemma restrict_vertex_edgeSource (D : Drawing G X) (h : H ≤ G) (e : E(H)) :
    (D.restrict h).vertex (edgeSource e) = D.vertex (edgeSource ⟨e.1, edgeSet_mono h e.2⟩) := by
  rw [restrict_vertex]
  congr 1
  ext
  simp [edgeSource, h.source]

lemma restrict_vertex_edgeTarget (D : Drawing G X) (h : H ≤ G) (e : E(H)) :
    (D.restrict h).vertex (edgeTarget e) = D.vertex (edgeTarget ⟨e.1, edgeSet_mono h e.2⟩) := by
  rw [restrict_vertex]
  congr 1
  ext
  simp [edgeTarget, h.target]

@[simp]
lemma range_edgePath_restrict (D : Drawing G X) (h : H ≤ G) (e : E(H)) :
    range ((D.restrict h).edgePath e) = range (D.edgePath ⟨e.1, edgeSet_mono h e.2⟩) := by
  ext x
  simp only [mem_range]
  refine ⟨fun ⟨t, ht⟩ ↦ ⟨t, ?_⟩, fun ⟨t, ht⟩ ↦ ⟨t, ?_⟩⟩ <;>
    rw [← ht, edgePath_apply, edgePath_apply, restrict_apply, h.RealizationEmbedding_edgePath]

end Drawing

namespace Iso

open TopologicalModel unitInterval

/-- The image of a vertex under a graph isomorphism, as a subtype. -/
noncomputable abbrev vert (F : Iso K G) (x : V(K)) : V(G) :=
  isoVert F x

/-- The image of an edge under a graph isomorphism, as a subtype. -/
noncomputable abbrev edge (F : Iso K G) (e : E(K)) : E(G) :=
  isoEdge F e

lemma isLink_vert_edge (F : Iso K G) (e : E(K)) :
    G.IsLink (F.edge e) (F.vert (edgeSource e)) (F.vert (edgeTarget e)) :=
  F.map_isLink (isLink_edgeSource_edgeTarget e) (isoEdge_spec F e)
    (isoVert_spec F _) (isoVert_spec F _)

/-- Whether `F` sends the preferred orientation of `e` to that of its image. -/
abbrev sameOrientation (F : Iso K G) (e : E(K)) : Prop :=
  F.vert (edgeSource e) = edgeSource (F.edge e)

lemma sameOrientation_or_swap (F : Iso K G) (e : E(K)) :
    F.sameOrientation e ∨
      (F.vert (edgeSource e) = edgeTarget (F.edge e) ∧
        F.vert (edgeTarget e) = edgeSource (F.edge e)) := by
  obtain ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩ :=
    (isLink_edgeSource_edgeTarget (F.edge e)).eq_and_eq_or_eq_and_eq (F.isLink_vert_edge e)
  · exact Or.inl <| Subtype.ext h₁.symm
  · exact Or.inr ⟨Subtype.ext h₂.symm, Subtype.ext h₁.symm⟩

lemma vert_edgeTarget_of_sameOrientation (F : Iso K G) {e : E(K)} (h : F.sameOrientation e) :
    F.vert (edgeTarget e) = edgeTarget (F.edge e) := by
  obtain ⟨_, h₂⟩ | ⟨h₁, h₂⟩ :=
    (isLink_edgeSource_edgeTarget (F.edge e)).eq_and_eq_or_eq_and_eq (F.isLink_vert_edge e)
  · exact Subtype.ext h₂.symm
  · have hsrc : F.vert (edgeSource e) = F.vert (edgeTarget e) := by
      rw [h, Subtype.ext_iff.mpr h₁]
    exact hsrc.symm.trans (Subtype.ext h₂.symm)

lemma vert_of_not_sameOrientation (F : Iso K G) {e : E(K)} (h : ¬ F.sameOrientation e) :
    F.vert (edgeSource e) = edgeTarget (F.edge e) ∧
      F.vert (edgeTarget e) = edgeSource (F.edge e) :=
  (F.sameOrientation_or_swap e).resolve_left h

/-- Reparametrization of the unit interval along `e`, flipping if `F` reverses orientation. -/
noncomputable def orient (F : Iso K G) (e : E(K)) : I → I :=
  open Classical in fun t ↦ if F.sameOrientation e then t else σ t

lemma continuous_orient (F : Iso K G) (e : E(K)) : Continuous (F.orient e) := by
  classical
  by_cases h : F.sameOrientation e
  · convert continuous_id (X := I)
    ext t
    simp [orient, if_pos h]
  · convert continuous_symm
    ext t
    simp [orient, if_neg h]

/-- The induced map on pre-realizations. -/
noncomputable def preRealizationMap (F : Iso K G) : C(K.PreRealization, G.PreRealization) where
  toFun
    | .inl v => .inl (F.vert v)
    | .inr ⟨e, t⟩ => .inr ⟨F.edge e, F.orient e t⟩
  continuous_toFun := continuous_sum_dom.mpr ⟨continuous_of_discreteTopology,
    continuous_sigma_iff.mpr fun e ↦ continuous_inr.comp <|
      continuous_sigmaMk.comp (F.continuous_orient e)⟩

lemma preRealizationMap_glueRel (F : Iso K G) ⦃a b : K.PreRealization⦄
    (h : K.glueRel a b) : G.glueRel (F.preRealizationMap a) (F.preRealizationMap b) := by
  classical
  induction h with
  | refl => rfl
  | symm _ _ _ ih => exact Setoid.symm ih
  | trans _ _ _ _ _ h₁ h₂ => exact Setoid.trans h₁ h₂
  | rel x y hxy =>
    match x, y with
    | .inr _, _ =>
      simp [glueRelAux] at hxy
    | .inl u, .inl v =>
      obtain rfl := (glueRelAux_inl_inl_iff ..).mp hxy
      rfl
    | .inl u, .inr ⟨e, t⟩ =>
      obtain ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ := (glueRelAux_inl_inr_iff ..).mp hxy
      · by_cases hori : F.sameOrientation e
        · convert (glueRel_inl_inr_iff (edgeSource (F.edge e)) (F.edge e) 0).mpr
            (.inl ⟨rfl, rfl⟩) using 1
          · simpa [preRealizationMap] using hori
          · simp [preRealizationMap, orient, if_pos hori]
        · obtain ⟨hs, _⟩ := F.vert_of_not_sameOrientation hori
          convert (glueRel_inl_inr_iff (edgeTarget (F.edge e)) (F.edge e) 1).mpr
            (.inr ⟨rfl, rfl⟩) using 1
          · simpa [preRealizationMap] using hs
          · simp [preRealizationMap, orient, if_neg hori]
      · by_cases hori : F.sameOrientation e
        · convert (glueRel_inl_inr_iff (edgeTarget (F.edge e)) (F.edge e) 1).mpr
            (.inr ⟨rfl, rfl⟩) using 1
          · simpa [preRealizationMap] using F.vert_edgeTarget_of_sameOrientation hori
          · simp [preRealizationMap, orient, if_pos hori]
        · obtain ⟨_, ht⟩ := F.vert_of_not_sameOrientation hori
          convert (glueRel_inl_inr_iff (edgeSource (F.edge e)) (F.edge e) 0).mpr
            (.inl ⟨rfl, rfl⟩) using 1
          · simpa [preRealizationMap] using ht
          · simp [preRealizationMap, orient, if_neg hori]

lemma vert_symm_vert (F : Iso K G) (x : V(K)) : F.symm.vert (F.vert x) = x := by
  ext
  change (F.vertMap.symm (F.vert x).val).get _ = x.val
  have hx : F.vertMap.symm (F.vert x).val = some x.val :=
    (F.vertMap.eq_some_iff).mpr (isoVert_spec F x)
  simp [hx]

lemma vert_vert_symm (F : Iso K G) (y : V(G)) : F.vert (F.symm.vert y) = y := by
  ext
  change (F.vertMap (F.symm.vert y).val).get _ = y.val
  have hy : F.vertMap (F.symm.vert y).val = some y.val :=
    (F.vertMap.eq_some_iff).mp (isoVert_spec F.symm y)
  simp [hy]

lemma edge_symm_edge (F : Iso K G) (e : E(K)) : F.symm.edge (F.edge e) = e := by
  ext
  change (F.edgeMap.symm (F.edge e).val).get _ = e.val
  have he : F.edgeMap.symm (F.edge e).val = some e.val :=
    (F.edgeMap.eq_some_iff).mpr (isoEdge_spec F e)
  simp [he]

lemma edge_edge_symm (F : Iso K G) (e : E(G)) : F.edge (F.symm.edge e) = e := by
  ext
  change (F.edgeMap (F.symm.edge e).val).get _ = e.val
  have he : F.edgeMap (F.symm.edge e).val = some e.val :=
    (F.edgeMap.eq_some_iff).mp (isoEdge_spec F.symm e)
  simp [he]

lemma sameOrientation_symm (F : Iso K G) {e : E(K)} (h : F.sameOrientation e) :
    F.symm.sameOrientation (F.edge e) := by
  unfold sameOrientation at h ⊢
  simpa [vert_symm_vert, edge_symm_edge] using congrArg F.symm.vert h.symm

lemma not_sameOrientation_symm (F : Iso K G) {e : E(K)} (h : ¬ F.sameOrientation e) :
    ¬ F.symm.sameOrientation (F.edge e) := by
  intro hs
  unfold sameOrientation at hs
  have hs' : F.symm.vert (edgeSource (F.edge e)) = edgeSource e := by
    simpa [edge_symm_edge] using hs
  have : F.vert (edgeSource e) = edgeSource (F.edge e) := by
    simpa [vert_vert_symm] using congrArg F.vert hs'.symm
  exact h this

lemma sameOrientation_edge_symm (F : Iso K G) (e : E(G)) :
    F.sameOrientation (F.symm.edge e) ↔ F.symm.sameOrientation e := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · unfold sameOrientation at h ⊢
    have h' : F.vert (edgeSource (F.symm.edge e)) = edgeSource e := by
      simpa [edge_edge_symm] using h
    simpa [vert_symm_vert] using congrArg F.symm.vert h'.symm
  · unfold sameOrientation at h ⊢
    have := congrArg F.vert h
    simpa [vert_vert_symm, edge_edge_symm] using this.symm

lemma orient_symm_orient (F : Iso K G) (e : E(K)) (t : I) :
    F.symm.orient (F.edge e) (F.orient e t) = t := by
  classical
  by_cases h : F.sameOrientation e
  · simp [orient, if_pos h, if_pos (F.sameOrientation_symm h)]
  · simp [orient, if_neg h, if_neg (F.not_sameOrientation_symm h), symm_symm]

lemma orient_orient_symm (F : Iso K G) (e : E(G)) (t : I) :
    F.orient (F.symm.edge e) (F.symm.orient e t) = t := by
  classical
  by_cases h : F.symm.sameOrientation e
  · simp [orient, if_pos h, if_pos ((F.sameOrientation_edge_symm e).mpr h)]
  · simp [orient, if_neg h, if_neg (mt (F.sameOrientation_edge_symm e).mp h), symm_symm]

lemma preRealizationMap_symm_comp (F : Iso K G) (x : K.PreRealization) :
    F.symm.preRealizationMap (F.preRealizationMap x) = x := by
  match x with
  | .inl v =>
    simp only [preRealizationMap, ContinuousMap.coe_mk, vert_symm_vert]
  | .inr ⟨e, t⟩ =>
    simp only [preRealizationMap, ContinuousMap.coe_mk, edge_symm_edge, orient_symm_orient]

lemma preRealizationMap_comp_symm (F : Iso K G) (x : G.PreRealization) :
    F.preRealizationMap (F.symm.preRealizationMap x) = x := by
  match x with
  | .inl v =>
    simp only [preRealizationMap, ContinuousMap.coe_mk, vert_vert_symm]
  | .inr ⟨e, t⟩ =>
    simp only [preRealizationMap, ContinuousMap.coe_mk, edge_edge_symm, orient_orient_symm]

/-- The homeomorphism of weak realizations induced by a graph isomorphism. -/
noncomputable def realizationHomeomorph (F : Iso K G) : Realization K ≃ₜ Realization G where
  toFun := Quotient.map F.preRealizationMap F.preRealizationMap_glueRel
  invFun := Quotient.map F.symm.preRealizationMap F.symm.preRealizationMap_glueRel
  left_inv := by
    intro x
    induction x using Realization.ind with | h a =>
    exact congrArg (Realization.mk K) (F.preRealizationMap_symm_comp a)
  right_inv := by
    intro x
    induction x using Realization.ind with | h a =>
    exact congrArg (Realization.mk G) (F.preRealizationMap_comp_symm a)
  continuous_toFun := by
    rw [continuous_coinduced_dom]
    exact continuous_coinduced_rng.comp F.preRealizationMap.continuous
  continuous_invFun := by
    rw [continuous_coinduced_dom]
    exact continuous_coinduced_rng.comp F.symm.preRealizationMap.continuous

end Iso

namespace Drawing

/-- Pull a drawing back along a graph isomorphism. -/
noncomputable def ofIso (D : Drawing G X) (F : Iso K G) : Drawing K X where
  toContinuousMap :=
    { toFun := D ∘ F.realizationHomeomorph
      continuous_toFun := D.continuous.comp F.realizationHomeomorph.continuous }
  inj' := D.injective.comp F.realizationHomeomorph.injective

/-- A drawing `D'` extends `D` along the subgraph inclusion `h`. -/
def Extends (D' : Drawing G X) (D : Drawing H X) (h : H ≤ G) : Prop :=
  ∀ x, D' (h.RealizationEmbedding x) = D x

/-! ### Drawability and planarity -/

end Drawing

/-- A graph is drawable in `X` if its weak realization admits a continuous injection into `X`. -/
def IsDrawable (G : Graph α β) (X : Type u) [TopologicalSpace X] : Prop :=
  Nonempty (Drawing G X)

/-- A graph is planar if it has a drawing in the Euclidean plane. -/
def Planar (G : Graph α β) : Prop :=
  G.IsDrawable (EuclideanSpace ℝ (Fin 2))

/-- The empty graph is drawable in every topological space. -/
theorem bot_isDrawable (X : Type u) [TopologicalSpace X] :
    (⊥ : Graph α β).IsDrawable X :=
  ⟨Drawing.bot X⟩

/-- The empty graph is planar. -/
theorem bot_planar : (⊥ : Graph α β).Planar :=
  bot_isDrawable (EuclideanSpace ℝ (Fin 2))

namespace IsDrawable

/-- Drawability is inherited by subgraphs. -/
lemma anti (hG : G.IsDrawable X) (hHG : H ≤ G) : H.IsDrawable X :=
  ⟨hG.some.restrict hHG⟩

/-- Drawability is invariant under graph isomorphism. -/
lemma of_iso (hG : G.IsDrawable X) (F : Iso K G) : K.IsDrawable X :=
  ⟨hG.some.ofIso F⟩

/-- Drawability is inherited by topological minors. -/
/- **Handoff to formalisation helper.** Needs a `Drawing` of `H` from a `Drawing` of `G` along a
`TopologicalModel` / `IsTopologicalMinor`: concatenate `D.edgePath` along each route, and check
disjointness of open cells against `route_internal_disjoint` / `route_edge_disjoint`. No named
`Drawing.ofTopologicalModel` (or equivalent) exists; building it is scaffolding, not a one-line
fill from `restrict`/`ofIso`. -/
theorem isTopologicalMinor (hG : G.IsDrawable X) (hHG : H.IsTopologicalMinor G) : H.IsDrawable X := by
  sorry

end IsDrawable

namespace Planar

/-- Planarity is inherited by subgraphs. -/
lemma anti (hG : G.Planar) (hHG : H ≤ G) : H.Planar :=
  IsDrawable.anti hG hHG

/-- Planarity is invariant under graph isomorphism. -/
lemma of_iso (hG : G.Planar) (F : Iso K G) : K.Planar :=
  IsDrawable.of_iso hG F

/-- Planarity is inherited by topological minors. -/
theorem isTopologicalMinor (hG : G.Planar) (hHG : H.IsTopologicalMinor G) : H.Planar :=
  IsDrawable.isTopologicalMinor hG hHG

/- **Proof route for the two theorems below** (formalisation helper). These are not small `sorry`

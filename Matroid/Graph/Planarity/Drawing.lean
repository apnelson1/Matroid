/-- The union of two finite planar graphs meeting in at most one vertex is planar. -/
theorem union_of_vertexSet_inter_subsingleton {G₁ G₂ : Graph α β} [G₁.Finite] [G₂.Finite]
    (h₁ : G₁.Planar) (h₂ : G₂.Planar) (hcompat : G₁.Compatible G₂)
    (hedge : Disjoint E(G₁) E(G₂)) (hvertex : (V(G₁) ∩ V(G₂)).Subsingleton) :
    (G₁ ∪ G₂).Planar := by
  sorry

/-- The union of two finite planar graphs along a common nonloop edge is planar. -/
theorem union_of_common_nonloop_edge {G₁ G₂ : Graph α β} [G₁.Finite] [G₂.Finite]
    (h₁ : G₁.Planar) (h₂ : G₂.Planar) (hcompat : G₁.Compatible G₂)
    (he₁ : G₁.IsLink e u v) (he₂ : G₂.IsLink e u v) (huv : u ≠ v)
    (hvertex : V(G₁) ∩ V(G₂) = {u, v}) (hedge : E(G₁) ∩ E(G₂) = {e}) :
    (G₁ ∪ G₂).Planar := by
  sorry

end Planar

abbrev Plane := EuclideanSpace ℝ (Fin 2)

/-- Embed a finite type into the plane along the x-axis. -/
noncomputable def embedFinite (ι : Type*) [Finite ι] : ι → Plane :=
  fun i => EuclideanSpace.single 0 (Finite.equivFin ι i : ℝ)

lemma embedFinite_injective (ι : Type*) [Finite ι] : Injective (embedFinite ι) := by
  intro a b h
  have : (Finite.equivFin ι a : ℝ) = (Finite.equivFin ι b : ℝ) := by
    simpa [embedFinite, PiLp.single_apply] using congrArg (fun v : Plane => v 0) h
  exact (Finite.equivFin ι).injective (Fin.val_injective (Nat.cast_injective this))

lemma pathInterior_segment (a b : Plane) :
    Drawing.pathInterior (Path.segment a b) = openSegment ℝ a b := by
  ext z
  constructor
  · rintro ⟨t, ht, rfl⟩
    rw [openSegment_eq_image_lineMap]
    exact ⟨t, ht, by simp [Path.segment_apply]⟩
  · rw [openSegment_eq_image_lineMap]
    rintro ⟨t, ht, rfl⟩
    exact ⟨⟨t, ht.1.le, ht.2.le⟩, ht, by simp [Path.segment_apply]⟩

/-- An edgeless finite graph is planar. -/
theorem noEdge_planar (V : Set α) (hV : V.Finite) : (Graph.noEdge V β).Planar := by
  have : (Graph.noEdge V β).Finite := (noEdge_finite V).mpr hV
  have : Finite ↑V(Graph.noEdge V β) := by
    simpa [vertexSet_noEdge] using hV.to_subtype
  refine ⟨Drawing.ofVertexAndEdgePaths (embedFinite _) (embedFinite_injective _)
    (fun ed => False.elim (by
      have : ed.1 ∈ (∅ : Set β) := by simpa [edgeSet_noEdge] using ed.2
      exact this))
    (fun ed => False.elim (by
      have : ed.1 ∈ (∅ : Set β) := by simpa [edgeSet_noEdge] using ed.2
      exact this))
    (fun ed => False.elim (by
      have : ed.1 ∈ (∅ : Set β) := by simpa [edgeSet_noEdge] using ed.2
      exact this))
    (fun ed _ _ => False.elim (by
      have : ed.1 ∈ (∅ : Set β) := by simpa [edgeSet_noEdge] using ed.2
      exact this))⟩

lemma singleEdge_edgeSource_ne_edgeTarget {x y : α} (hxy : x ≠ y) (e : β)
    (f : E(Graph.singleEdge x y e)) : edgeSource f ≠ edgeTarget f := by
  intro heq
  have hlink := isLink_edgeSource_edgeTarget f
  have hf : (f : β) = e := by simpa [edgeSet_singleEdge] using f.2
  have heq' : (edgeSource f : α) = edgeTarget f := congrArg Subtype.val heq
  rw [singleEdge_isLink_iff, hf, heq'] at hlink
  obtain ⟨-, hs⟩ := hlink
  obtain ⟨h1, h2⟩ | ⟨h1, h2⟩ := Sym2.eq_iff.mp hs
  · exact hxy (h1.symm.trans h2)
  · exact hxy (h2.symm.trans h1)

/-- A nonloop edge is planar. -/
theorem singleEdge_planar {x y : α} (hxy : x ≠ y) (e : β) : (Graph.singleEdge x y e).Planar := by
  set G := Graph.singleEdge x y e
  have : Finite ↑V(G) := by
    change Finite ↑({x, y} : Set α)
    infer_instance
  set vertex : V(G) → Plane := embedFinite V(G)
  have hv : Injective vertex := embedFinite_injective _
  have hne : ∀ f : E(G), edgeSource f ≠ edgeTarget f :=
    fun f ↦ singleEdge_edgeSource_ne_edgeTarget hxy e f
  set edge : ∀ f : E(G), Path (vertex (edgeSource f)) (vertex (edgeTarget f)) :=
    fun f => Path.segment (vertex (edgeSource f)) (vertex (edgeTarget f))
  refine ⟨Drawing.ofVertexAndEdgePaths vertex hv edge ?_ ?_ ?_⟩
  · intro f _ _ _ _ heq
    exact Path.segment_injective_of_ne (hv.ne (hne f)) heq
  · intro f
    have hne' : vertex (edgeSource f) ≠ vertex (edgeTarget f) := hv.ne (hne f)
    have hnotL : vertex (edgeSource f) ∉
        openSegment ℝ (vertex (edgeSource f)) (vertex (edgeTarget f)) :=
      fun h ↦ hne' (left_mem_openSegment_iff.mp h)
    have hnotR : vertex (edgeTarget f) ∉
        openSegment ℝ (vertex (edgeSource f)) (vertex (edgeTarget f)) :=
      fun h ↦ hne' (right_mem_openSegment_iff.mp h)
    refine disjoint_left.mpr ?_
    rintro z ⟨t, ht, rfl⟩ ⟨v, hvz⟩
    have hzopen : edge f t ∈ openSegment ℝ (vertex (edgeSource f)) (vertex (edgeTarget f)) := by
      simpa [← pathInterior_segment] using ⟨t, ht, rfl⟩
    have hf : (f : β) = e := by simpa [G, edgeSet_singleEdge] using f.2
    have hlink : s((edgeSource f : α), (edgeTarget f : α)) = s(x, y) := by
      simpa [hf, G, singleEdge_isLink_iff] using isLink_edgeSource_edgeTarget f
    have hvxy : (v : α) = x ∨ (v : α) = y := by
      simpa [G, vertexSet_singleEdge] using v.2
    have hmap : vertex v = vertex (edgeSource f) ∨ vertex v = vertex (edgeTarget f) := by
      rcases Sym2.eq_iff.mp hlink with ⟨hs, ht⟩ | ⟨hs, ht⟩
      · rcases hvxy with hvx | hvy
        · exact Or.inl (congrArg vertex (Subtype.ext (hvx.trans hs.symm)))
        · exact Or.inr (congrArg vertex (Subtype.ext (hvy.trans ht.symm)))
      · rcases hvxy with hvx | hvy
        · exact Or.inr (congrArg vertex (Subtype.ext (hvx.trans ht.symm)))
        · exact Or.inl (congrArg vertex (Subtype.ext (hvy.trans hs.symm)))
    rcases hmap with hmap | hmap
    · exact hnotL (by rwa [← hvz, hmap] at hzopen)
    · exact hnotR (by rwa [← hvz, hmap] at hzopen)
  · intro f g hfg
    have hf : (f : β) = e := by simpa [G, edgeSet_singleEdge] using f.2
    have hg : (g : β) = e := by simpa [G, edgeSet_singleEdge] using g.2
    exact (hfg (Subtype.ext (hf.trans hg.symm))).elim

/-- Every finite forest is planar. -/
theorem IsForest.planar [G.Finite] (hG : G.IsForest) : G.Planar := by
  induction hn : V(G).ncard using Nat.strong_induction_on generalizing G with
  | h n ih =>
    subst hn
    obtain hE | hE := E(G).eq_empty_or_nonempty
    · rw [edgeSet_eq_empty_iff.mp hE]
      exact noEdge_planar _ G.vertexSet_finite
    · obtain ⟨ed, xv, hp⟩ := hG.exists_isPendant hE
      obtain ⟨yv, hyV, hlink, hyx, heH, hGeq⟩ := hp.eq_addEdge
      set H := G - ({xv} : Set α)
      have hHplanar : H.Planar :=
        ih V(H).ncard (ncard_delete_vertex_lt hp.vertex_mem) (hG.anti deleteVerts_le) rfl
      have hEplanar : (Graph.singleEdge xv yv ed).Planar := singleEdge_planar hyx.symm ed
      have hedge : Disjoint E(Graph.singleEdge xv yv ed) E(H) := by
        simpa [edgeSet_singleEdge] using (disjoint_singleton_left.mpr heH)
      have hcompat : (Graph.singleEdge xv yv ed).Compatible H :=
        Compatible.of_disjoint_edgeSet hedge
      have hvertex : (V(Graph.singleEdge xv yv ed) ∩ V(H)).Subsingleton := by
        intro a ha b hb
        have ha' : a = yv := by
          have : a ∈ ({xv, yv} : Set α) ∩ V(H) := by simpa [vertexSet_singleEdge] using ha
          have hx : xv ∉ V(H) := by simp [H, vertexSet_deleteVerts]
          simp only [mem_inter_iff, mem_insert_iff, mem_singleton_iff] at this
          obtain ⟨rfl | rfl, haH⟩ := this
          · exact absurd haH hx
          · rfl
        have hb' : b = yv := by
          have : b ∈ ({xv, yv} : Set α) ∩ V(H) := by simpa [vertexSet_singleEdge] using hb
          have hx : xv ∉ V(H) := by simp [H, vertexSet_deleteVerts]
          simp only [mem_inter_iff, mem_insert_iff, mem_singleton_iff] at this
          obtain ⟨rfl | rfl, hbH⟩ := this
          · exact absurd hbH hx
          · rfl
        exact ha'.trans hb'.symm
      have hunion : (Graph.singleEdge xv yv ed ∪ H).Planar :=
        Planar.union_of_vertexSet_inter_subsingleton hEplanar hHplanar hcompat hedge hvertex
      convert hunion
      simpa [Graph.addEdge] using hGeq

/-! ### Straight-line drawing on at most four vertices -/

private def toPlane (x y : ℝ) : Plane := (WithLp.equiv 2 (Fin 2 → ℝ)).symm ![x, y]

@[simp] private lemma toPlane_zero (x y : ℝ) : toPlane x y 0 = x := by simp [toPlane]
@[simp] private lemma toPlane_one (x y : ℝ) : toPlane x y 1 = y := by simp [toPlane]

/-- Four plane points realizing a triangle with an interior vertex: `(0,0)`, `(2,0)`, `(0,2)`,
`(1,1/2)`. -/
private def pts4 : Fin 4 → Plane :=
  ![toPlane 0 0, toPlane 2 0, toPlane 0 2, toPlane 1 (1 / 2)]

private lemma pts4_injective : Injective pts4 := by
  intro a b h
  have hx := congrArg (fun v : Plane => v 0) h
  have hy := congrArg (fun v : Plane => v 1) h
  fin_cases a <;> fin_cases b <;> simp [pts4] at hx hy ⊢

private lemma linInd_of_det {u v : Plane} (h : u 0 * v 1 - u 1 * v 0 ≠ 0) :
    LinearIndependent ℝ ![u, v] := by
  rw [linearIndependent_fin2]
  refine ⟨?_, fun a ha => ?_⟩
  · intro hv
    exact h (by
      have hv0 : v 0 = 0 := by simpa using congrArg (fun w : Plane => w 0) hv
      have hv1 : v 1 = 0 := by simpa using congrArg (fun w : Plane => w 1) hv
      simp [hv0, hv1])
  · have h0 := congrArg (fun w : Plane => w 0) ha
    have h1 := congrArg (fun w : Plane => w 1) ha
    simp [PiLp.smul_apply] at h0 h1
    refine h ?_
    calc
      u 0 * v 1 - u 1 * v 0
          = (a * v 0) * v 1 - (a * v 1) * v 0 := by rw [← h0, ← h1]
        _ = 0 := by ring

private lemma det_pts4_star {c x y : Fin 4} (hx : x ≠ c) (hy : y ≠ c) (hxy : x ≠ y) :
    (pts4 x - pts4 c) 0 * (pts4 y - pts4 c) 1 -
      (pts4 x - pts4 c) 1 * (pts4 y - pts4 c) 0 ≠ 0 := by
  fin_cases c <;> fin_cases x <;> fin_cases y <;>
    simp_all [pts4, PiLp.sub_apply] <;> norm_num

private lemma linearIndependent_pts4_star {c x y : Fin 4}
    (hx : x ≠ c) (hy : y ≠ c) (hxy : x ≠ y) :
    LinearIndependent ℝ ![pts4 x - pts4 c, pts4 y - pts4 c] :=
  linInd_of_det (det_pts4_star hx hy hxy)

private lemma openSegment_star_disjoint {c x y : Fin 4}
    (hx : x ≠ c) (hy : y ≠ c) (hxy : x ≠ y) :
    Disjoint (openSegment ℝ (pts4 c) (pts4 x)) (openSegment ℝ (pts4 c) (pts4 y)) := by
  refine disjoint_left.2 fun p hpx hpy => ?_
  have hinter : p ∈ segment ℝ (pts4 c) (pts4 x) ∩ segment ℝ (pts4 c) (pts4 y) :=
    ⟨openSegment_subset_segment _ _ _ hpx, openSegment_subset_segment _ _ _ hpy⟩
  have hp : p = pts4 c := by
    have := segment_inter_eq_endpoint_of_linearIndependent_sub ℝ
      (linearIndependent_pts4_star hx hy hxy)
    simpa [this] using hinter
  have : pts4 c = pts4 x := (left_mem_openSegment_iff (y := pts4 x)).mp (by rwa [hp] at hpx)
  exact hx (pts4_injective this.symm)

private lemma not_mem_openSegment_pts4 {i j k : Fin 4}
    (hij : i ≠ j) (hik : k ≠ i) (hjk : k ≠ j) :
    pts4 k ∉ openSegment ℝ (pts4 i) (pts4 j) := by
  intro h
  rw [openSegment_eq_image'] at h
  obtain ⟨t, ⟨ht0, ht1⟩, heq⟩ := h
  have hx := congrArg (fun v : Plane => v 0) heq
  have hy := congrArg (fun v : Plane => v 1) heq
  simp [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply] at hx hy
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    simp_all [pts4] <;> (try linarith)

private lemma openSegment_eq_of_sym2 {a b c d : Fin 4} (h : s(a, b) = s(c, d)) :
    openSegment ℝ (pts4 a) (pts4 b) = openSegment ℝ (pts4 c) (pts4 d) := by
  rcases (Sym2.eq_iff).mp h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · rfl
  · exact openSegment_symm _ _ _

private lemma openSegment_01_23 :
    Disjoint (openSegment ℝ (pts4 0) (pts4 1)) (openSegment ℝ (pts4 2) (pts4 3)) := by
  refine disjoint_left.2 fun p hp01 hp23 => ?_
  rw [openSegment_eq_image'] at hp01 hp23
  obtain ⟨s, ⟨hs0, hs1⟩, rfl⟩ := hp01
  obtain ⟨t, ⟨ht0, ht1⟩, heq⟩ := hp23
  have hy := congrArg (fun v : Plane => v 1) heq
  simp [pts4, PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply] at hy
  have : t = 4 / 3 := by ring_nf at hy; linarith
  linarith

private lemma openSegment_02_13 :
    Disjoint (openSegment ℝ (pts4 0) (pts4 2)) (openSegment ℝ (pts4 1) (pts4 3)) := by
  refine disjoint_left.2 fun p hp01 hp23 => ?_
  rw [openSegment_eq_image'] at hp01 hp23
  obtain ⟨s, ⟨hs0, hs1⟩, rfl⟩ := hp01
  obtain ⟨t, ⟨ht0, ht1⟩, heq⟩ := hp23
  have hx := congrArg (fun v : Plane => v 0) heq
  simp [pts4, PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply] at hx
  have : t = 2 := by linarith
  linarith

private lemma openSegment_12_03 :
    Disjoint (openSegment ℝ (pts4 1) (pts4 2)) (openSegment ℝ (pts4 0) (pts4 3)) := by
  refine disjoint_left.2 fun p hp12 hp03 => ?_
  rw [openSegment_eq_image'] at hp12 hp03
  obtain ⟨s, ⟨hs0, hs1⟩, rfl⟩ := hp12
  obtain ⟨t, ⟨ht0, ht1⟩, heq⟩ := hp03
  have hx := congrArg (fun v : Plane => v 0) heq
  have hy := congrArg (fun v : Plane => v 1) heq
  simp [pts4, PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply] at hx hy
  have hs : s = 1 / 3 := by
    have ht : t = 2 - 2 * s := by linarith
    have : 2 * s = t / 2 := by linarith
    rw [ht] at this; linarith
  have : t = 4 / 3 := by linarith
  linarith

private lemma exists_canon_edge {a b : Fin 4} (hab : a ≠ b) :
    ∃ u v : Fin 4, u < v ∧ s(a, b) = s(u, v) := by
  wlog hlt : a < b generalizing a b
  · obtain ⟨u, v, huv, heq⟩ := this hab.symm (lt_of_le_of_ne (le_of_not_gt hlt) hab.symm)
    exact ⟨u, v, huv, by simpa [Sym2.eq_swap] using heq⟩
  exact ⟨a, b, hlt, rfl⟩

private lemma openSegment_pts4_disjoint_complementary {u v u' v' : Fin 4}
    (huv : u < v) (huv' : u' < v') (hne : s(u, v) ≠ s(u', v'))
    (hdisj : Disjoint ({u, v} : Set (Fin 4)) {u', v'}) :
    Disjoint (openSegment ℝ (pts4 u) (pts4 v)) (openSegment ℝ (pts4 u') (pts4 v')) := by
  fin_cases u <;> fin_cases v <;> fin_cases u' <;> fin_cases v' <;>
    simp_all [Fin.lt_def] <;>
    first
    | exact openSegment_01_23
    | exact openSegment_02_13
    | exact openSegment_12_03
    | exact openSegment_01_23.symm
    | exact openSegment_02_13.symm
    | exact openSegment_12_03.symm

private lemma openSegment_pts4_disjoint {i j k ℓ : Fin 4}
    (hij : i ≠ j) (hkl : k ≠ ℓ) (hne : s(i, j) ≠ s(k, ℓ)) :
    Disjoint (openSegment ℝ (pts4 i) (pts4 j)) (openSegment ℝ (pts4 k) (pts4 ℓ)) := by
  obtain ⟨u, v, huv, heq1⟩ := exists_canon_edge hij
  obtain ⟨u', v', huv', heq2⟩ := exists_canon_edge hkl
  have hne' : s(u, v) ≠ s(u', v') := fun h => hne (heq1.trans (h.trans heq2.symm))
  rw [openSegment_eq_of_sym2 heq1, openSegment_eq_of_sym2 heq2]
  by_cases hshare : ({u, v} ∩ {u', v'} : Set (Fin 4)).Nonempty
  · obtain ⟨c, hc⟩ := hshare
    have hc1 : c ∈ ({u, v} : Set _) := hc.1
    have hc2 : c ∈ ({u', v'} : Set _) := hc.2
    let x : Fin 4 := if c = u then v else u
    let y : Fin 4 := if c = u' then v' else u'
    have hx : x ≠ c := by
      dsimp [x]; split_ifs with hcu
      · exact hcu ▸ huv.ne'
      · have : c = v := by
          simp only [mem_insert_iff, mem_singleton_iff] at hc1
          exact hc1.resolve_left hcu
        exact this ▸ huv.ne
    have hy : y ≠ c := by
      dsimp [y]; split_ifs with hcu
      · exact hcu ▸ huv'.ne'
      · have : c = v' := by
          simp only [mem_insert_iff, mem_singleton_iff] at hc2
          exact hc2.resolve_left hcu
        exact this ▸ huv'.ne
    have hxy : x ≠ y := by
      intro heqxy
      apply hne'
      have e1 : s(u, v) = s(c, x) := by
        dsimp [x]; split_ifs with hcu
        · subst hcu; rfl
        · have : c = v := by
            simp only [mem_insert_iff, mem_singleton_iff] at hc1
            exact hc1.resolve_left hcu
          subst this; exact Sym2.eq_swap
      have e2 : s(u', v') = s(c, y) := by
        dsimp [y]; split_ifs with hcu
        · subst hcu; rfl
        · have : c = v' := by
            simp only [mem_insert_iff, mem_singleton_iff] at hc2
            exact hc2.resolve_left hcu
          subst this; exact Sym2.eq_swap
      exact e1.trans (heqxy ▸ e2.symm)
    have e1 : openSegment ℝ (pts4 u) (pts4 v) = openSegment ℝ (pts4 c) (pts4 x) := by
      dsimp [x]; split_ifs with hcu
      · subst hcu; rfl
      · have : c = v := by
          simp only [mem_insert_iff, mem_singleton_iff] at hc1
          exact hc1.resolve_left hcu
        subst this; exact openSegment_symm _ _ _
    have e2 : openSegment ℝ (pts4 u') (pts4 v') = openSegment ℝ (pts4 c) (pts4 y) := by
      dsimp [y]; split_ifs with hcu
      · subst hcu; rfl
      · have : c = v' := by
          simp only [mem_insert_iff, mem_singleton_iff] at hc2
          exact hc2.resolve_left hcu
        subst this; exact openSegment_symm _ _ _
    rw [e1, e2]
    exact openSegment_star_disjoint hx hy hxy
  · push Not at hshare
    have hdisj : Disjoint ({u, v} : Set (Fin 4)) {u', v'} := by
      rw [disjoint_iff_inter_eq_empty]; simpa using hshare
    exact openSegment_pts4_disjoint_complementary huv huv' hne' hdisj

/-- Every finite simple graph on at most four vertices is planar.

This is proved by a straight-line drawing with vertices at
`(0,0)`, `(2,0)`, `(0,2)`, `(1,1/2)` (triangle plus interior point) and edges as segments,
fed to `Drawing.ofVertexAndEdgePaths`. -/
theorem planar_of_vertexSet_encard_le_four [G.Finite] [G.Simple]
    (hG : V(G).encard ≤ 4) : G.Planar := by
  have : Fintype V(G) := Fintype.ofFinite _
  have hcard : Fintype.card V(G) ≤ 4 := by
    have heq : V(G).encard = (Fintype.card V(G) : ℕ∞) := by
      rw [Set.encard_eq_coe_toFinset_card, Set.toFinset_card]
    have : ((Fintype.card V(G) : ℕ) : ℕ∞) ≤ 4 := by rwa [← heq]
    exact Nat.cast_le.mp this
  let ι : V(G) ↪ Fin 4 :=
    (Fintype.equivFin V(G)).toEmbedding.trans (Fin.castLEEmb hcard)
  set vertex : V(G) → Plane := pts4 ∘ ι
  have hv : Injective vertex := pts4_injective.comp ι.injective
  have hne : ∀ e : E(G), edgeSource e ≠ edgeTarget e := by
    intro e heq
    exact (isLink_edgeSource_edgeTarget e).ne (congrArg Subtype.val heq)
  set edge : ∀ e : E(G), Path (vertex (edgeSource e)) (vertex (edgeTarget e)) :=
    fun e => Path.segment (vertex (edgeSource e)) (vertex (edgeTarget e))
  refine ⟨Drawing.ofVertexAndEdgePaths vertex hv edge ?_ ?_ ?_⟩
  · intro e _ _ _ _ heq
    exact Path.segment_injective_of_ne (hv.ne (hne e)) heq
  · intro e
    rw [pathInterior_segment]
    refine disjoint_left.mpr ?_
    rintro z hz ⟨w, rfl⟩
    have hij : ι (edgeSource e) ≠ ι (edgeTarget e) := ι.injective.ne (hne e)
    have hz' : pts4 (ι w) ∈
        openSegment ℝ (pts4 (ι (edgeSource e))) (pts4 (ι (edgeTarget e))) := by
      simpa [vertex] using hz
    by_cases h1 : ι w = ι (edgeSource e)
    · rw [h1] at hz'
      exact hij (pts4_injective (left_mem_openSegment_iff.mp hz'))
    · by_cases h2 : ι w = ι (edgeTarget e)
      · rw [h2] at hz'
        exact hij (pts4_injective (right_mem_openSegment_iff.mp hz'))
      · exact not_mem_openSegment_pts4 hij h1 h2 hz'
  · intro e f hef
    rw [pathInterior_segment, pathInterior_segment]
    have hij : ι (edgeSource e) ≠ ι (edgeTarget e) := ι.injective.ne (hne e)
    have hkl : ι (edgeSource f) ≠ ι (edgeTarget f) := ι.injective.ne (hne f)
    have hends : G.ends e ≠ G.ends f := (ends_injective G).ne hef
    have hne_sym : s(ι (edgeSource e), ι (edgeTarget e)) ≠
        s(ι (edgeSource f), ι (edgeTarget f)) := by
      intro heq
      apply hends
      have he : G.ends e = s(edgeSource e, edgeTarget e) :=
        (isLink_edgeSource_edgeTarget e).ends_eq
      have hf : G.ends f = s(edgeSource f, edgeTarget f) :=
        (isLink_edgeSource_edgeTarget f).ends_eq
      refine (Sym2.map.injective ι.injective) ?_
      simpa [he, hf, Sym2.map_mk] using heq
    simpa [vertex] using openSegment_pts4_disjoint hij hkl hne_sym


